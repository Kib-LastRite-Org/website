---
interface Props {
	title: string;
	subtitle?: string | undefined;
}

const { title, subtitle } = Astro.props;
---

<div class="border-b border-outline-variant px-6 py-5">
	<div class="flex items-start justify-between gap-4">
		<div>
			<div class="flex items-center gap-3">
				<!-- Accent dot uses brand primary (mint) -->
				<div class="h-3 w-3 rounded-full bg-primary"></div>
				<h2 class="text-3xl font-bold tracking-tight text-on-surface">
					{title}
				</h2>
			</div>

			{
				subtitle && (
					<p class="mt-2 text-sm text-on-surface-variant">{subtitle}</p>
				)
			}
		</div>

		<button
			id="drawer-close-button"
			class="rounded-xl border border-outline-variant bg-surface-container p-2 transition hover:bg-surface-container-high"
			aria-label="Close drawer"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="h-5 w-5 text-on-surface"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M6 18L18 6M6 6l12 12"
				/>
			</svg>
		</button>
	</div>
</div>
