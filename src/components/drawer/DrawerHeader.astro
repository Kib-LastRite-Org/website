---
/**
 * DrawerHeader — top bar of the SideDrawer panel.
 * Uses <div> for all text to escape the global `h1-h6` font-size rules
 * that would otherwise override Tailwind utilities (CSS layer issue in v4).
 */
interface Props {
	title: string;
	subtitle?: string | undefined;
}

const { title, subtitle } = Astro.props;
---

<div class="drawer-header">
	<div class="drawer-header-content">
		<div class="drawer-title-row">
			<span class="drawer-accent-dot" aria-hidden="true"></span>
			<span class="drawer-title">{title}</span>
		</div>
		{subtitle && <span class="drawer-subtitle">{subtitle}</span>}
	</div>

	<button
		id="drawer-close-button"
		class="drawer-close-btn"
		aria-label="Close drawer"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="16"
			height="16"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
			stroke-width="2.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M6 18L18 6M6 6l12 12"></path>
		</svg>
	</button>
</div>

<!--
  Scoped styles are emitted outside any @layer by Astro, so they beat
  Tailwind v4 utilities AND global element selectors alike.
-->
<style>
	.drawer-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		padding: 18px 20px 16px;
		border-bottom: 1px solid var(--color-outline-variant);
		flex-shrink: 0;
	}

	.drawer-header-content {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.drawer-title-row {
		display: flex;
		align-items: center;
		gap: 9px;
	}

	.drawer-accent-dot {
		flex-shrink: 0;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background-color: var(--color-primary);
	}

	/* Explicit px avoids em/rem cascade issues entirely */
	.drawer-title {
		font-size: 17px;
		font-weight: 700;
		color: var(--color-on-surface);
		line-height: 1.3;
		letter-spacing: -0.01em;
		font-family: var(--font-display);
	}

	.drawer-subtitle {
		font-size: 12px;
		color: var(--color-on-surface-variant);
		line-height: 1.5;
		/* indent to align text past the dot */
		padding-left: 16px;
	}

	.drawer-close-btn {
		flex-shrink: 0;
		width: 32px;
		height: 32px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--color-outline-variant);
		border-radius: 8px;
		background: transparent;
		color: var(--color-on-surface-variant);
		cursor: pointer;
		transition:
			background 0.15s,
			color 0.15s,
			border-color 0.15s;
		/* reset any inherited margin that global * { margin:0 } might have re-added */
		margin: 0;
		padding: 0;
	}

	.drawer-close-btn:hover {
		background: var(--color-surface-container);
		color: var(--color-on-surface);
		border-color: var(--color-outline);
	}
</style>
