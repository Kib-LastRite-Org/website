---
interface Props {
	title?: string | undefined;
	subtitle?: string | undefined;
	description?: string | undefined;
}

const { title, subtitle, description } = Astro.props;
---

<div class="rounded-2xl border border-outline-variant bg-surface-container-low p-5">
	{title && <h4 class="text-lg font-semibold text-on-surface">{title}</h4>}
	{subtitle && <p class="mt-1 text-sm text-on-surface-variant">{subtitle}</p>}
	{
		description && (
			<p class="mt-3 leading-7 text-on-surface-variant">{description}</p>
		)
	}
</div>
