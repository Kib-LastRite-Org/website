---
/**
 * TextCard — plain text/description card.
 * All text uses div/p, not heading elements, to bypass global h-tag styles.
 */
interface Props {
	title?: string | undefined;
	subtitle?: string | undefined;
	description?: string | undefined;
}

const { title, subtitle, description } = Astro.props;
---

<div class="text-card">
	{title && <div class="text-card-title">{title}</div>}
	{subtitle && <div class="text-card-sub">{subtitle}</div>}
	{description && <p class="text-card-desc">{description}</p>}
</div>

<style>
	.text-card {
		border-radius: 12px;
		border: 1px solid var(--color-outline-variant);
		background: var(--color-surface-container-low);
		padding: 14px 16px;
	}

	.text-card-title {
		font-size: 14px;
		font-weight: 600;
		color: var(--color-on-surface);
		line-height: 1.4;
		font-family: var(--font-display);
	}

	.text-card-sub {
		font-size: 12px;
		color: var(--color-on-surface-variant);
		margin-top: 3px;
		line-height: 1.5;
	}

	.text-card-desc {
		font-size: 13px;
		color: var(--color-on-surface-variant);
		line-height: 1.65;
		margin-top: 9px;
		/* reset the global * { margin: 0 } for bottom */
		margin-bottom: 0;
	}
</style>
