---
interface Props {
	title?: string | undefined;
	subtitle?: string | undefined;
	description?: string | undefined;
	image?: string | undefined;
	meta?: string[] | undefined;
	rating?: number | undefined;
}

const { title, subtitle, description, image, meta, rating } = Astro.props;
---

<div class="rounded-2xl border border-outline-variant bg-surface-container-low p-4">
	<div class="flex gap-4">
		{
			image && (
				<img
					src={image}
					alt={title ?? "Media"}
					class="h-36 w-24 flex-shrink-0 rounded-xl object-cover"
				/>
			)
		}

		<div class="flex-1 min-w-0">
			<div class="flex flex-wrap items-center gap-3">
				{
					title && (
						<h4 class="text-3xl font-bold text-on-surface">{title}</h4>
					)
				}

				{
					rating !== undefined && (
						/* Secondary (orange/warm) maps perfectly to star ratings */
						<div class="flex items-center gap-1 text-secondary">
							<span aria-hidden="true">★</span>
							<span class="text-lg font-semibold">{rating}</span>
						</div>
					)
				}
			</div>

			{subtitle && <p class="mt-1 text-sm text-on-surface-variant">{subtitle}</p>}

			{
				meta && meta.length > 0 && (
					<div class="mt-2 flex flex-wrap gap-3 text-sm text-on-surface-variant">
						{meta.map((tag) => (
							<span>{tag}</span>
						))}
					</div>
				)
			}

			{
				description && (
					<p class="mt-4 text-base leading-8 text-on-surface-variant">
						{description}
					</p>
				)
			}
		</div>
	</div>
</div>
